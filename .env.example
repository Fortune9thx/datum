# DATUM -- Studio Dev (chain 61997) only. Copy to .env and fill in.
# NEVER put a private key in a frontend repo file. The deploy keystore
# variables below are read only by scripts/deploy.mjs (a local CLI script,
# not shipped to the browser).

# --- Frontend (Next.js, must use the NEXT_PUBLIC_ prefix to reach the browser) ---
# Leave the address empty until code is actually live at it -- the app probes
# gen_getContractSchema and fails closed (empty lists, zeros, writes disabled)
# when it is unset, missing code, or unreachable.
NEXT_PUBLIC_DATUM_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=61997
NEXT_PUBLIC_RPC_URL=https://studio-dev.genlayer.com/api

# The explorer URL and chain id are also compiled into src/lib/datum/network.ts.
# The network is deliberately locked to Studio Next (61997) in code so a stray
# env value cannot silently repoint the app at another chain.
# Explorer: https://explorer-studio-dev.genlayer.com

# --- Deploy script only (scripts/deploy.mjs), never committed, never in frontend/ ---
DATUM_KEYSTORE_PATH=
DATUM_KEYSTORE_PASSWORD=
